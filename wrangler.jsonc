{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akipasa",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP_SNAPSHOTS", "class_name": "MapSnapshot" }],
  },
  "migrations": [
    { "tag": "map-snapshot-v1", "new_sqlite_classes": ["MapSnapshot"] },
  ],
  "services": [
    { "binding": "AKIHQ_GATEWAY", "service": "akihq-integration-gateway" },
  ],
  "routes": [
    { "pattern": "akipasa.com", "custom_domain": true },
    { "pattern": "www.akipasa.com", "custom_domain": true },
    { "pattern": "akiduermo.akipasa.com", "custom_domain": true },
    { "pattern": "business.akipasa.com", "custom_domain": true },
    { "pattern": "akiconduzco.akipasa.com", "custom_domain": true },
  ],
  "vars": {
    "NEXT_PUBLIC_PRODUCT_NAME": "AkiPasa",
    "NEXT_PUBLIC_DATA_PROVIDER": "hybrid",
    "NEXT_PUBLIC_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty",
    "NEXT_PUBLIC_GOOGLE_AUTH_ENABLED": "true",
    "NEXT_PUBLIC_BUSINESS_URL": "https://business.akipasa.com",
    "AKIPASA_TRANSLATION_URL": "https://translate.terraprint.co/translate",
    "NEXT_PUBLIC_SUPABASE_URL": "https://akipasa.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Mm4CJvGyIaLOWbU3g1sxIQ_Wv2jrKt1",
    "STRIPE_PREMIUM_MONTHLY_PRICE_ID": "price_1U7vvqGfzDhsgsQZ1QwqXMjR",
    "STRIPE_PREMIUM_YEARLY_PRICE_ID": "price_1U7vwYGfzDhsgsQZ4aJ2vkEn",
    "STRIPE_BUSINESS_MONTHLY_PRICE_ID": "price_1Ty802GfzDhsgsQZPLHDu9qp",
    "STRIPE_BUSINESS_YEARLY_PRICE_ID": "price_1Ty80FGfzDhsgsQZYrgDHG7Y",
    "STRIPE_BUSINESS_PRO_MONTHLY_PRICE_ID": "price_1UB3nzGfzDhsgsQZ4HNDaIiM",
    "STRIPE_BUSINESS_PRO_YEARLY_PRICE_ID": "price_1UB3okGfzDhsgsQZ2Wy6ArO8",
    "AKISUITE_STRIPE_ACCOUNT_ID": "acct_1SVLH2GfzDhsgsQZ",
    "AKIBUSINESS_OPERATIONS_BILLING_READY": "true",
    "AKIBUSINESS_OPERATIONS_MIGRATIONS_READY": "true",
    "AKIBUSINESS_OPERATIONS_CHECKOUT_READY": "false",
    "AKIBUSINESS_OPERATIONS_TAX_READY": "false",
    "AKISUITE_CHECKOUT_ENABLED": "false",
    "AKISUITE_TAX_READY": "false",
    "AKISUITE_SUBSCRIPTIONS_READY": "false",
    "AKISUITE_FEATURES_READY": "false",
    "AKISUITE_PRIVATE_IDENTITY_EXPORTS_READY": "true",
    "AKISUITE_FUNNEL_READY": "true",
    "AKISUITE_LISTING_LIMITS_READY": "true",
    "AKISUITE_LISTING_UPLOADS_READY": "true",
    "AKISUITE_BILLING_VERIFIED": "false",
    "STRIPE_AKISUITE_AKIPASA_PREMIUM_MONTH_PRICE_ID": "price_1UTt5YGfzDhsgsQZV1Fx5rt7",
    "STRIPE_AKISUITE_AKIPASA_PREMIUM_YEAR_PRICE_ID": "price_1UPmD7GfzDhsgsQZeXqvR0vo",
    "STRIPE_AKISUITE_AKIBUSINESS_PREMIUM_MONTH_PRICE_ID": "price_1UTt5ZGfzDhsgsQZNIatyDxl",
    "STRIPE_AKISUITE_AKIBUSINESS_PREMIUM_YEAR_PRICE_ID": "price_1UPmDGGfzDhsgsQZBm7Xdsgd",
    "STRIPE_AKISUITE_AKIDUERMO_PREMIUM_MONTH_PRICE_ID": "price_1UTt5bGfzDhsgsQZmZB2pxfA",
    "STRIPE_AKISUITE_AKIDUERMO_PREMIUM_YEAR_PRICE_ID": "price_1UPmDKGfzDhsgsQZfbDTriSu",
    "STRIPE_AKISUITE_AKIHQ_STANDARD_MONTH_PRICE_ID": "price_1UPmDMGfzDhsgsQZbcNXSRCC",
    "STRIPE_AKISUITE_AKIHQ_STANDARD_YEAR_PRICE_ID": "price_1UPmDOGfzDhsgsQZfvwiJv41",
    "STRIPE_AKISUITE_AKIHQ_PRO_MONTH_PRICE_ID": "price_1UPmDRGfzDhsgsQZQ63P4zjM",
    "STRIPE_AKISUITE_AKIHQ_PRO_YEAR_PRICE_ID": "price_1UPmDTGfzDhsgsQZ8Pl8tLR2",
    "STRIPE_AKISUITE_AKIHQ_BUSINESS_ADDON_MONTH_PRICE_ID": "price_1UPmDWGfzDhsgsQZ0Jym6yBU",
    "STRIPE_AKISUITE_AKIHQ_BUSINESS_ADDON_YEAR_PRICE_ID": "price_1UPmDYGfzDhsgsQZDZHYx66B",
    "STRIPE_AKISUITE_ENTERPRISE_MONTH_PRICE_ID": "price_1UPmDaGfzDhsgsQZhkqYwj57",
    "STRIPE_AKISUITE_ENTERPRISE_YEAR_PRICE_ID": "price_1UPmDdGfzDhsgsQZzkWUymhk",
  },
  "limits": {
    "cpu_ms": 1000,
    "subrequests": 100,
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
