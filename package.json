{
  "name": "akipasa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment node tests/discovery.test.ts tests/moderation.test.ts tests/auth-security.test.ts tests/account-export.test.ts tests/account-workspaces.test.tsx tests/roles.test.ts tests/locations.test.ts tests/repository.test.ts tests/time.test.ts tests/feature-flags.test.ts tests/badges.test.ts tests/admin-catalogue.test.tsx tests/admin-users.test.ts tests/workspace-shell.test.tsx tests/user-search.test.tsx tests/stripe.test.ts",
    "test:watch": "vitest --environment node tests/discovery.test.ts",
    "test:db-safety": "node scripts/test-local-database-safety.mjs",
    "db:seed:local": "node scripts/local-database.mjs seed",
    "db:reset:local": "node scripts/local-database.mjs reset",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "automation:check": "npm --prefix automation run check",
    "automation:dev": "npm --prefix automation run dev",
    "build:cloudflare": "node scripts/run-cloudflare.mjs build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db-safety && npm run automation:check && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.110.8",
    "clsx": "2.1.1",
    "maplibre-gl": "^5.12.0",
    "next": "15.5.21",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.1.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.21",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "eslint": "9.27.0",
    "eslint-config-next": "15.5.21",
    "jsdom": "26.1.0",
    "postgres": "^3.4.7",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
