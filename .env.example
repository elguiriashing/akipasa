NEXT_PUBLIC_PRODUCT_NAME=AkiPasa
NEXT_PUBLIC_SITE_URL=https://akipasa.com
NEXT_PUBLIC_CRM_URL=https://crm.akipasa.com
NEXT_PUBLIC_DATA_PROVIDER=hybrid
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
AI_SCHEDULER_SECRET=

AKIPASA_LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Operator-only; never put this production credential in Cloudflare variables.
AKIPASA_BACKUP_DATABASE_URL=
